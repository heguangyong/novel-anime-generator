<?xml version="1.0" encoding="UTF-8"?>
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">
    
    <!-- Project Management Entities -->
    <entity entity-name="Project" package="novel.anime" authorize-skip="create,update,delete">
        <field name="projectId" type="id" is-pk="true"/>
        <field name="name" type="text-medium" not-null="true"/>
        <field name="description" type="text-long"/>
        <field name="userId" type="id" not-null="true"/>
        <field name="status" type="text-short" default="'active'"/>
        <field name="createdDate" type="date-time"/>
        <field name="lastUpdated" type="date-time"/>
        <relationship type="one" related="novel.anime.user.NovelAnimeUser"/>
        <index name="PROJECT_USER_IDX">
            <index-field name="userId"/>
        </index>
    </entity>

    <!-- Novel Structure Entities -->
    <entity entity-name="Novel" package="novel.anime" authorize-skip="create,update,delete">
        <field name="novelId" type="id" is-pk="true"/>
        <field name="projectId" type="id"/>
        <field name="title" type="text-medium"/>
        <field name="author" type="text-medium"/>
        <field name="originalText" type="text-very-long"/>
        <field name="wordCount" type="number-integer"/>
        <field name="status" type="text-short"/>
        <field name="sourceType" type="text-short"/> <!-- text, file -->
        <field name="filename" type="text-medium"/>
        <field name="createdDate" type="date-time"/>
        <field name="lastUpdated" type="date-time"/>
        <relationship type="one" related="novel.anime.Project"/>
        <!-- Performance: Index for project queries -->
        <index name="NOVEL_PROJECT_IDX">
            <index-field name="projectId"/>
        </index>
        <!-- Performance: Index for status filtering -->
        <index name="NOVEL_STATUS_IDX">
            <index-field name="status"/>
        </index>
    </entity>

    <entity entity-name="Chapter" package="novel.anime" authorize-skip="create,update,delete">
        <field name="chapterId" type="id" is-pk="true"/>
        <field name="novelId" type="id"/>
        <field name="chapterNumber" type="number-integer"/>
        <field name="title" type="text-medium"/>
        <field name="content" type="text-very-long"/>
        <field name="wordCount" type="number-integer"/>
        <field name="createdDate" type="date-time"/>
        <relationship type="one" related="novel.anime.Novel"/>
        <!-- Performance: Index for novel queries -->
        <index name="CHAPTER_NOVEL_IDX">
            <index-field name="novelId"/>
        </index>
        <!-- Performance: Composite index for ordered queries -->
        <index name="CHAPTER_NOVEL_NUMBER_IDX">
            <index-field name="novelId"/>
            <index-field name="chapterNumber"/>
        </index>
    </entity>

    <entity entity-name="Scene" package="novel.anime" authorize-skip="create,update,delete">
        <field name="sceneId" type="id" is-pk="true"/>
        <field name="chapterId" type="id"/>
        <field name="sceneNumber" type="number-integer"/>
        <field name="title" type="text-medium"/> <!-- 场景标题 -->
        <field name="content" type="text-very-long"/>
        <field name="setting" type="text-medium"/>
        <field name="mood" type="text-short"/>
        <field name="visualDescription" type="text-long"/>
        <field name="timeOfDay" type="text-short"/>
        <field name="weather" type="text-short"/>
        <field name="analysisStatus" type="text-short"/>
        <field name="isApproved" type="text-indicator"/>
        <relationship type="one" related="novel.anime.Chapter"/>
        <!-- Performance: Index for chapter queries -->
        <index name="SCENE_CHAPTER_IDX">
            <index-field name="chapterId"/>
        </index>
        <!-- Performance: Index for status filtering -->
        <index name="SCENE_STATUS_IDX">
            <index-field name="analysisStatus"/>
        </index>
    </entity>

    <!-- Character System Entities -->
    <entity entity-name="Character" package="novel.anime">
        <field name="characterId" type="id" is-pk="true"/>
        <field name="novelId" type="id"/>
        <field name="name" type="text-medium"/>
        <field name="role" type="text-short"/> <!-- protagonist, antagonist, supporting, minor -->
        <field name="description" type="text-long"/>
        <field name="appearance" type="text-long"/>
        <field name="personality" type="text-long"/>
        <field name="firstMention" type="text-medium"/>
        <field name="mentionCount" type="number-integer"/>
        <field name="extractionConfidence" type="number-decimal"/>
        <field name="isLocked" type="text-indicator"/>
        <field name="createdDate" type="date-time"/>
        <relationship type="one" related="novel.anime.Novel"/>
        <!-- Performance: Index for novel queries -->
        <index name="CHARACTER_NOVEL_IDX">
            <index-field name="novelId"/>
        </index>
        <!-- Performance: Index for role filtering -->
        <index name="CHARACTER_ROLE_IDX">
            <index-field name="role"/>
        </index>
        <!-- Performance: Composite index for filtered queries -->
        <index name="CHARACTER_NOVEL_ROLE_IDX">
            <index-field name="novelId"/>
            <index-field name="role"/>
        </index>
    </entity>

    <entity entity-name="CharacterRelationship" package="novel.anime">
        <field name="relationshipId" type="id" is-pk="true"/>
        <field name="fromCharacterId" type="id"/>
        <field name="toCharacterId" type="id"/>
        <field name="relationshipType" type="text-short"/>
        <field name="description" type="text-medium"/>
        <relationship type="one" title="From" related="novel.anime.Character">
            <key-map field-name="fromCharacterId" related="characterId"/>
        </relationship>
        <relationship type="one" title="To" related="novel.anime.Character">
            <key-map field-name="toCharacterId" related="characterId"/>
        </relationship>
    </entity>

    <entity entity-name="CharacterAppearance" package="novel.anime">
        <field name="appearanceId" type="id" is-pk="true"/>
        <field name="characterId" type="id"/>
        <field name="sceneId" type="id"/>
        <field name="description" type="text-medium"/>
        <relationship type="one" related="novel.anime.Character"/>
        <relationship type="one" related="novel.anime.Scene"/>
    </entity>

    <!-- Episode and Script Entities -->
    <entity entity-name="Episode" package="novel.anime">
        <field name="episodeId" type="id" is-pk="true"/>
        <field name="novelId" type="id"/>
        <field name="episodeNumber" type="number-integer"/>
        <field name="title" type="text-medium"/>
        <field name="summary" type="text-long"/>
        <field name="duration" type="number-decimal"/>
        <field name="status" type="text-short"/>
        <field name="createdDate" type="date-time"/>
        <relationship type="one" related="novel.anime.Novel"/>
    </entity>

    <entity entity-name="EpisodeScene" package="novel.anime">
        <field name="episodeSceneId" type="id" is-pk="true"/>
        <field name="episodeId" type="id"/>
        <field name="sceneId" type="id"/>
        <field name="sequenceNumber" type="number-integer"/>
        <relationship type="one" related="novel.anime.Episode"/>
        <relationship type="one" related="novel.anime.Scene"/>
    </entity>

    <entity entity-name="Screenplay" package="novel.anime">
        <field name="screenplayId" type="id" is-pk="true"/>
        <field name="episodeId" type="id"/>
        <field name="content" type="text-very-long"/>
        <field name="format" type="text-short"/>
        <field name="createdDate" type="date-time"/>
        <relationship type="one" related="novel.anime.Episode"/>
    </entity>

    <!-- Storyboard and Video Generation Entities -->
    <entity entity-name="Storyboard" package="novel.anime">
        <field name="storyboardId" type="id" is-pk="true"/>
        <field name="episodeId" type="id"/>
        <field name="totalDuration" type="number-decimal"/>
        <field name="status" type="text-short"/>
        <field name="createdDate" type="date-time"/>
        <relationship type="one" related="novel.anime.Episode"/>
    </entity>

    <entity entity-name="ShotSpecification" package="novel.anime">
        <field name="shotId" type="id" is-pk="true"/>
        <field name="storyboardId" type="id"/>
        <field name="shotNumber" type="number-integer"/>
        <field name="duration" type="number-decimal"/>
        <field name="cameraAngle" type="text-short"/>
        <field name="shotType" type="text-short"/>
        <field name="visualDescription" type="text-long"/>
        <field name="aiPrompt" type="text-long"/>
        <field name="setting" type="text-medium"/>
        <relationship type="one" related="novel.anime.Storyboard"/>
    </entity>

    <entity entity-name="VideoSegment" package="novel.anime">
        <field name="videoSegmentId" type="id" is-pk="true"/>
        <field name="shotId" type="id"/>
        <field name="filePath" type="text-medium"/>
        <field name="duration" type="number-decimal"/>
        <field name="status" type="text-short"/>
        <field name="generatedDate" type="date-time"/>
        <relationship type="one" related="novel.anime.ShotSpecification"/>
    </entity>

    <!-- Asset Library Entities -->
    <entity entity-name="Asset" package="novel.anime" authorize-skip="create,update,delete">
        <field name="assetId" type="id" is-pk="true"/>
        <field name="projectId" type="id"/>
        <field name="novelId" type="id"/>
        <field name="userId" type="id"/>
        <field name="assetType" type="text-short"/> <!-- character, scene, image, audio, video -->
        <field name="name" type="text-medium"/>
        <field name="description" type="text-long"/>
        <field name="filePath" type="text-medium"/>
        <field name="fileSize" type="number-integer"/> <!-- in bytes -->
        <field name="metadata" type="text-very-long"/>
        <field name="version" type="text-short"/>
        <field name="isShared" type="text-indicator"/>
        <field name="createdDate" type="date-time"/>
        <field name="lastUpdatedDate" type="date-time"/>
        <relationship type="one" related="novel.anime.Project"/>
        <relationship type="one" related="novel.anime.Novel"/>
        <relationship type="one" related="novel.anime.user.NovelAnimeUser"/>
        <index name="ASSET_PROJECT_IDX">
            <index-field name="projectId"/>
        </index>
        <index name="ASSET_TYPE_IDX">
            <index-field name="assetType"/>
        </index>
    </entity>

    <entity entity-name="AssetVersion" package="novel.anime">
        <field name="versionId" type="id" is-pk="true"/>
        <field name="assetId" type="id"/>
        <field name="versionNumber" type="text-short"/>
        <field name="filePath" type="text-medium"/>
        <field name="changeDescription" type="text-medium"/>
        <field name="createdDate" type="date-time"/>
        <relationship type="one" related="novel.anime.Asset"/>
    </entity>

    <!-- Workflow and Processing Entities -->
    <entity entity-name="ProcessingPipeline" package="novel.anime" authorize-skip="create,update,delete">
        <field name="pipelineId" type="id" is-pk="true"/>
        <field name="novelId" type="id"/>
        <field name="status" type="text-short"/>
        <field name="currentStage" type="text-short"/>
        <field name="totalStages" type="number-integer" default="4"/>
        <field name="completedStages" type="number-integer" default="0"/>
        <field name="configuration" type="text-very-long"/>
        <field name="creditsReserved" type="number-integer"/>
        <field name="creditsUsed" type="number-integer"/>
        <field name="estimatedDuration" type="number-integer"/>
        <field name="startedDate" type="date-time"/>
        <field name="completedDate" type="date-time"/>
        <relationship type="one" related="novel.anime.Novel"/>
    </entity>

    <entity entity-name="ProcessingStage" package="novel.anime">
        <field name="stageId" type="id" is-pk="true"/>
        <field name="pipelineId" type="id"/>
        <field name="stageName" type="text-short"/>
        <field name="status" type="text-short"/>
        <field name="progress" type="number-decimal"/>
        <field name="errorMessage" type="text-long"/>
        <field name="startedDate" type="date-time"/>
        <field name="completedDate" type="date-time"/>
        <relationship type="one" related="novel.anime.ProcessingPipeline"/>
    </entity>

    <!-- User Business Extension Entity (linked to Moqui UserAccount for authentication) -->
    <entity entity-name="NovelAnimeUser" package="novel.anime.user">
        <field name="userId" type="id" is-pk="true"/>
        <field name="email" type="text-medium"/>
        <field name="avatarUrl" type="text-very-long"/>
        <field name="credits" type="number-integer" default="500"/>
        <field name="status" type="text-short" default="'active'"/>
        <field name="createdDate" type="date-time"/>
        <field name="lastLoginDate" type="date-time"/>
        <relationship type="one" related="moqui.security.UserAccount"/>
    </entity>

    <!-- OAuth Account Linking Entity -->
    <entity entity-name="UserOAuthAccount" package="novel.anime.user">
        <field name="oauthAccountId" type="id" is-pk="true"/>
        <field name="userId" type="id" not-null="true"/>
        <field name="provider" type="text-short" not-null="true"/>
        <field name="providerUserId" type="text-medium" not-null="true"/>
        <field name="accessToken" type="text-medium"/>
        <field name="refreshToken" type="text-medium"/>
        <field name="tokenExpiry" type="date-time"/>
        <field name="profileData" type="text-very-long"/>
        <field name="createdDate" type="date-time"/>
        <field name="lastUsedDate" type="date-time"/>
        <relationship type="one" related="novel.anime.user.NovelAnimeUser"/>
        <index name="OAUTH_PROVIDER_USER_IDX" unique="true">
            <index-field name="provider"/>
            <index-field name="providerUserId"/>
        </index>
    </entity>

    <!-- Credits Transaction Entity -->
    <entity entity-name="CreditTransaction" package="novel.anime.user">
        <field name="transactionId" type="id" is-pk="true"/>
        <field name="userId" type="id" not-null="true"/>
        <field name="amount" type="number-integer" not-null="true"/>
        <field name="type" type="text-short" not-null="true"/>
        <field name="operationType" type="text-medium"/>
        <field name="description" type="text-medium"/>
        <field name="balanceAfter" type="number-integer"/>
        <field name="timestamp" type="date-time"/>
        <relationship type="one" related="novel.anime.user.NovelAnimeUser"/>
        <index name="CT_USER_TIMESTAMP_IDX">
            <index-field name="userId"/>
            <index-field name="timestamp"/>
        </index>
    </entity>

    <!-- ========== Workflow Management Entities ========== -->

    <!-- 工作流定义 -->
    <entity entity-name="Workflow" package="novel.anime" authorize-skip="create,update,delete">
        <field name="workflowId" type="id" is-pk="true"/>
        <field name="projectId" type="id"/>
        <field name="userId" type="id"/>
        <field name="name" type="text-medium" not-null="true"/>
        <field name="description" type="text-long"/>
        <field name="status" type="text-short" default="'idle'"/> <!-- idle, running, completed, error -->
        <field name="nodesJson" type="text-very-long"/>
        <field name="connectionsJson" type="text-very-long"/>
        <field name="createdDate" type="date-time"/>
        <field name="lastUpdatedDate" type="date-time"/>
        <relationship type="one" related="novel.anime.Project"/>
        <relationship type="one" related="novel.anime.user.NovelAnimeUser"/>
        <index name="WORKFLOW_PROJECT_IDX">
            <index-field name="projectId"/>
        </index>
        <index name="WORKFLOW_USER_IDX">
            <index-field name="userId"/>
        </index>
    </entity>

    <!-- 工作流执行记录 -->
    <entity entity-name="WorkflowExecution" package="novel.anime" authorize-skip="create,update,delete">
        <field name="executionId" type="id" is-pk="true"/>
        <field name="workflowId" type="id"/>
        <field name="workflowName" type="text-medium"/>
        <field name="status" type="text-short" default="'running'"/> <!-- running, success, failed, cancelled -->
        <field name="startTime" type="date-time"/>
        <field name="endTime" type="date-time"/>
        <field name="duration" type="number-integer"/> <!-- in seconds -->
        <field name="nodeCount" type="number-integer"/>
        <field name="logsJson" type="text-very-long"/>
        <field name="createdDate" type="date-time"/>
        <relationship type="one" related="novel.anime.Workflow"/>
        <index name="WF_EXEC_WORKFLOW_IDX">
            <index-field name="workflowId"/>
        </index>
    </entity>

    <!-- 工作流模板 -->
    <entity entity-name="WorkflowTemplate" package="novel.anime" authorize-skip="create,update,delete">
        <field name="templateId" type="id" is-pk="true"/>
        <field name="userId" type="id"/> <!-- null for built-in templates -->
        <field name="name" type="text-medium" not-null="true"/>
        <field name="description" type="text-long"/>
        <field name="isBuiltIn" type="text-indicator" default="'N'"/>
        <field name="nodeCount" type="number-integer"/>
        <field name="estimatedTime" type="text-short"/>
        <field name="useCase" type="text-medium"/>
        <field name="nodesJson" type="text-very-long"/>
        <field name="connectionsJson" type="text-very-long"/>
        <field name="createdDate" type="date-time"/>
        <field name="lastUpdatedDate" type="date-time"/>
        <relationship type="one" related="novel.anime.user.NovelAnimeUser"/>
    </entity>

    <!-- 用户设置 -->
    <entity entity-name="UserSettings" package="novel.anime.user" authorize-skip="create,update,delete">
        <field name="userId" type="id" is-pk="true"/>
        <field name="theme" type="text-short" default="'system'"/> <!-- dark, light, system -->
        <field name="language" type="text-short" default="'zh-CN'"/> <!-- zh-CN, en-US -->
        <field name="notificationEmail" type="text-indicator" default="'Y'"/>
        <field name="notificationPush" type="text-indicator" default="'Y'"/>
        <field name="defaultWorkflowTemplate" type="id"/>
        <field name="autoSave" type="text-indicator" default="'Y'"/>
        <field name="createdDate" type="date-time"/>
        <field name="lastUpdatedDate" type="date-time"/>
        <relationship type="one" related="novel.anime.user.NovelAnimeUser"/>
    </entity>

</entities>