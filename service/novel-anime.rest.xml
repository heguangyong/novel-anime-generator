<?xml version="1.0" encoding="UTF-8"?>
<!-- Novel Anime Generator REST API Definition -->
<resource xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/rest-api-3.xsd"
        name="novel-anime" displayName="Novel Anime Generator REST API" version="1.0.0" require-authentication="anonymous-view"
        description="REST API for Novel Anime Generator - User Authentication and Credits Management">

    <!-- Authentication Resources -->
    <resource name="auth">
        <resource name="status">
            <method type="get"><service name="novel.anime.AuthServices.get#SystemStatus"/></method>
        </resource>
        <resource name="login">
            <method type="post"><service name="novel.anime.AuthServices.login#User"/></method>
        </resource>
        <resource name="register">
            <method type="post"><service name="novel.anime.AuthServices.register#User"/></method>
        </resource>
        <resource name="logout">
            <method type="post"><service name="novel.anime.AuthServices.logout#User"/></method>
        </resource>
        <resource name="user">
            <method type="get"><service name="novel.anime.AuthServices.get#CurrentUser"/></method>
        </resource>
    </resource>

    <!-- Test Resources -->
    <resource name="test">
        <resource name="status">
            <method type="get"><service name="novel.anime.TestServices.get#TestStatus"/></method>
        </resource>
    </resource>

    <!-- Workflow Resources -->
    <resource name="workflows">
        <method type="get"><service name="novel.anime.TestServices.get#Workflows"/></method>
        <method type="post"><service name="novel.anime.TestServices.create#Workflow"/></method>
    </resource>

    <!-- Single Workflow Resource -->
    <resource name="workflow">
        <method type="get"><service name="novel.anime.TestServices.get#Workflow"/></method>
        <method type="put"><service name="novel.anime.TestServices.update#Workflow"/></method>
        <method type="delete"><service name="novel.anime.TestServices.delete#Workflow"/></method>
    </resource>

    <!-- Workflow Execution Resources -->
    <resource name="workflow-executions">
        <method type="get"><service name="novel.anime.TestServices.get#WorkflowExecutions"/></method>
        <method type="post"><service name="novel.anime.TestServices.create#WorkflowExecution"/></method>
    </resource>

    <!-- Single Workflow Execution Resource -->
    <resource name="workflow-execution">
        <method type="get"><service name="novel.anime.TestServices.get#WorkflowExecution"/></method>
        <method type="post"><service name="novel.anime.TestServices.create#WorkflowExecution"/></method>
        <method type="put"><service name="novel.anime.TestServices.update#WorkflowExecution"/></method>
    </resource>

    <!-- Workflow Template Resources -->
    <resource name="workflow-templates">
        <method type="get"><service name="novel.anime.TestServices.get#WorkflowTemplates"/></method>
        <method type="post"><service name="novel.anime.TestServices.create#WorkflowTemplate"/></method>
    </resource>

    <!-- Single Workflow Template Resource -->
    <resource name="workflow-template">
        <method type="get"><service name="novel.anime.TestServices.get#WorkflowTemplate"/></method>
        <method type="put"><service name="novel.anime.TestServices.update#WorkflowTemplate"/></method>
        <method type="delete"><service name="novel.anime.TestServices.delete#WorkflowTemplate"/></method>
    </resource>

    <!-- Asset Resources -->
    <resource name="assets">
        <method type="get"><service name="novel.anime.TestServices.get#Assets"/></method>
        <method type="post"><service name="novel.anime.TestServices.create#Asset"/></method>
    </resource>

    <!-- Single Asset Resource -->
    <resource name="asset">
        <method type="get"><service name="novel.anime.TestServices.get#Asset"/></method>
        <method type="put"><service name="novel.anime.TestServices.update#Asset"/></method>
        <method type="delete"><service name="novel.anime.TestServices.delete#Asset"/></method>
    </resource>

    <!-- User Settings Resources -->
    <resource name="user-settings">
        <method type="get"><service name="novel.anime.TestServices.get#UserSettings"/></method>
        <method type="put"><service name="novel.anime.TestServices.update#UserSettings"/></method>
    </resource>

    <!-- Project Resources -->
    <resource name="projects">
        <method type="get"><service name="novel.anime.TestServices.get#Projects"/></method>
        <method type="post"><service name="novel.anime.TestServices.create#Project"/></method>
    </resource>

    <!-- Single Project Resource -->
    <resource name="project">
        <method type="get"><service name="novel.anime.TestServices.get#Project"/></method>
        <method type="put"><service name="novel.anime.TestServices.update#Project"/></method>
        <method type="delete"><service name="novel.anime.TestServices.delete#Project"/></method>
    </resource>

    <!-- Novel Resources -->
    <resource name="novels">
        <method type="get"><service name="novel.anime.TestServices.get#Novels"/></method>
        <resource name="import-text">
            <method type="post"><service name="novel.anime.TestServices.import#NovelText"/></method>
        </resource>
        <resource name="import-file">
            <method type="post"><service name="novel.anime.TestServices.import#NovelFile"/></method>
        </resource>
        <resource name="analyze-structure">
            <method type="post"><service name="novel.anime.TestServices.analyze#NovelStructure"/></method>
        </resource>
        <resource name="extract-characters">
            <method type="post"><service name="novel.anime.TestServices.extract#NovelCharacters"/></method>
        </resource>
        <resource name="episodes">
            <method type="get"><service name="novel.anime.TestServices.get#Episodes"/></method>
            <resource name="generate">
                <method type="post"><service name="novel.anime.TestServices.generate#Episodes"/></method>
            </resource>
            <resource name="stats">
                <method type="get"><service name="novel.anime.TestServices.get#EpisodeStats"/></method>
            </resource>
        </resource>
        <resource name="scenes">
            <method type="get"><service name="novel.anime.TestServices.get#Scenes"/></method>
            <resource name="enhance">
                <method type="post"><service name="novel.anime.TestServices.enhance#Scenes"/></method>
            </resource>
            <resource name="stats">
                <method type="get"><service name="novel.anime.TestServices.get#SceneStats"/></method>
            </resource>
        </resource>
        <resource name="pipeline">
            <resource name="create">
                <method type="post"><service name="novel.anime.TestServices.create#Pipeline"/></method>
            </resource>
            <resource name="status">
                <method type="get"><service name="novel.anime.TestServices.get#PipelineStatus"/></method>
            </resource>
            <resource name="update">
                <method type="put"><service name="novel.anime.TestServices.update#PipelineProgress"/></method>
            </resource>
            <resource name="complete">
                <method type="post"><service name="novel.anime.TestServices.complete#Pipeline"/></method>
            </resource>
            <resource name="fail">
                <method type="post"><service name="novel.anime.TestServices.fail#Pipeline"/></method>
            </resource>
        </resource>
    </resource>

    <!-- Single Novel Resource -->
    <resource name="novel">
        <method type="get"><service name="novel.anime.TestServices.get#Novel"/></method>
        <method type="put"><service name="novel.anime.TestServices.update#Novel"/></method>
        <method type="delete"><service name="novel.anime.TestServices.delete#Novel"/></method>
    </resource>

    <!-- Characters Resources -->
    <resource name="characters">
        <method type="get"><service name="novel.anime.TestServices.get#Characters"/></method>
    </resource>

    <!-- Single Character Resource -->
    <resource name="character">
        <method type="get"><service name="novel.anime.TestServices.get#Character"/></method>
        <method type="put"><service name="novel.anime.TestServices.update#Character"/></method>
        <method type="delete"><service name="novel.anime.TestServices.delete#Character"/></method>
        <resource name="lock">
            <method type="post"><service name="novel.anime.TestServices.lock#Character"/></method>
        </resource>
        <resource name="relationships">
            <method type="post"><service name="novel.anime.TestServices.create#CharacterRelationship"/></method>
        </resource>
    </resource>

    <!-- Character Merge -->
    <resource name="characters-merge">
        <method type="post"><service name="novel.anime.TestServices.merge#Characters"/></method>
    </resource>

    <!-- Episode Resources -->
    <resource name="episode">
        <method type="put"><service name="novel.anime.TestServices.update#Episode"/></method>
        <method type="delete"><service name="novel.anime.TestServices.delete#Episode"/></method>
        <resource name="screenplay">
            <method type="post"><service name="novel.anime.TestServices.generate#EpisodeScreenplay"/></method>
        </resource>
        <resource name="adjust-boundaries">
            <method type="post"><service name="novel.anime.TestServices.adjust#EpisodeBoundaries"/></method>
        </resource>
    </resource>

    <!-- Scene Resources -->
    <resource name="scene">
        <method type="put"><service name="novel.anime.TestServices.update#Scene"/></method>
        <resource name="approve">
            <method type="post"><service name="novel.anime.TestServices.approve#Scene"/></method>
        </resource>
        <resource name="reanalyze">
            <method type="post"><service name="novel.anime.TestServices.reanalyze#Scene"/></method>
        </resource>
    </resource>

</resource>
